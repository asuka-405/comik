{
  "name": "comik",
  "private": true,
  "version": "0.3.1-beta",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,proxy -c auto \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:proxy": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:native": "node scripts/build-native.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:debug": "gradle -p android assembleDebug",
    "desktop:linux": "npm run build:native && electron-builder --projectDir desktop --linux AppImage",
    "desktop:windows:portable": "npm run build:native && electron-builder --projectDir desktop --win dir --config.asar=false --config.win.signAndEditExecutable=false && node scripts/package-windows-portable.mjs",
    "desktop:windows": "npm run build:native && electron-builder --projectDir desktop --win nsis"
  },
  "allowScripts": {
    "electron": true,
    "app-builder-bin": true
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@phosphor-icons/react": "^2.1.10",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "firebase": "^13.1.0",
    "hono": "^4.13.13",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
